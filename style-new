/* =========================================================
   SiNG BOX — NEW DESIGN
   style-new.css
   ========================================================= */


/* =========================
   VARIABLES
========================= */

:root {
    --bg: #03110d;
    --bg-deep: #010906;
    --bg-soft: #071812;

    --cream: #f4e5c7;
    --gold: #e6bd77;
    --gold-soft: #c99d5d;

    --pink: #ff3b8d;
    --pink-light: #ff5ca3;

    --white: #f7f4ee;
    --muted: #b8b8ae;

    --border: rgba(230, 189, 119, 0.28);
    --border-soft: rgba(255, 255, 255, 0.09);

    --serif: "Cormorant Garamond", Georgia, serif;
    --sans: "Outfit", Arial, sans-serif;

    --header-height: 82px;

    --content-width: 1440px;
}


/* =========================
   RESET
========================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
    scroll-padding-top: var(--header-height);
}

body {
    background:
        radial-gradient(
            circle at 20% 20%,
            rgba(8, 54, 38, 0.22),
            transparent 35%
        ),
        var(--bg);

    color: var(--white);

    font-family: var(--sans);

    font-weight: 300;

    line-height: 1.6;

    overflow-x: hidden;
}

body::selection {
    background: var(--pink);
    color: white;
}

img {
    display: block;
    width: 100%;
}

a {
    color: inherit;
    text-decoration: none;
}

button {
    font: inherit;
}

section {
    position: relative;
}


/* =========================
   TYPOGRAPHY
========================= */

h1,
h2 {
    font-family: var(--serif);

    color: var(--cream);

    font-weight: 500;

    text-transform: uppercase;

    letter-spacing: 0.015em;

    line-height: 0.92;
}

h3 {
    font-weight: 500;
}

p {
    color: rgba(255, 255, 255, 0.78);
}

.eyebrow {
    margin-bottom: 18px;

    color: var(--gold);

    font-size: 0.72rem;

    font-weight: 500;

    letter-spacing: 0.28em;

    text-transform: uppercase;
}

.gold-line {
    width: 46px;
    height: 1px;

    margin: 27px 0;

    background: var(--gold);
}

.spaced-copy {
    color: rgba(255, 255, 255, 0.78);

    font-size: 0.76rem;

    letter-spacing: 0.36em;

    text-transform: uppercase;
}


/* =========================
   BUTTONS
========================= */

.pink-button,
.outline-button {
    display: inline-flex;

    align-items: center;
    justify-content: center;

    gap: 28px;

    min-height: 52px;

    padding: 0 35px;

    text-transform: uppercase;

    font-size: 0.75rem;
    font-weight: 500;

    letter-spacing: 0.04em;

    transition:
        transform 0.3s ease,
        background 0.3s ease,
        border-color 0.3s ease,
        box-shadow 0.3s ease;
}

.pink-button {
    border-radius: 999px;

    background:
        linear-gradient(
            135deg,
            var(--pink),
            #ff4c9c
        );

    color: #10080b;

    box-shadow:
        0 12px 35px rgba(255, 59, 141, 0.23),
        inset 0 1px 0 rgba(255, 255, 255, 0.25);
}

.pink-button:hover {
    transform: translateY(-3px);

    box-shadow:
        0 18px 45px rgba(255, 59, 141, 0.35),
        inset 0 1px 0 rgba(255, 255, 255, 0.3);
}

.outline-button {
    border: 1px solid var(--gold);

    border-radius: 999px;

    color: var(--cream);

    background: rgba(0, 0, 0, 0.12);
}

.outline-button:hover {
    transform: translateY(-3px);

    background: var(--gold);

    color: #07100c;

    box-shadow:
        0 12px 30px rgba(230, 189, 119, 0.16);
}


/* =========================
   HEADER
========================= */

.site-header {
    position: fixed;

    top: 0;
    left: 0;

    z-index: 1000;

    width: 100%;

    background:
        linear-gradient(
            180deg,
            rgba(1, 10, 7, 0.97),
            rgba(1, 10, 7, 0.86)
        );

    border-bottom: 1px solid rgba(230, 189, 119, 0.09);

    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
}

.header-inner {
    width: min(var(--content-width), 92%);

    min-height: var(--header-height);

    margin: 0 auto;

    display: grid;

    grid-template-columns:
        minmax(180px, 1fr)
        auto
        minmax(250px, 1fr);

    align-items: center;

    gap: 30px;
}


/* =========================
   LOGO
========================= */

.brand {
    display: inline-flex;

    width: max-content;

    flex-direction: column;

    align-items: center;

    color: var(--cream);
}

.brand-name {
    position: relative;

    font-size: 1.8rem;

    font-weight: 500;

    letter-spacing: 0.05em;

    line-height: 1;
}

.brand-name::before,
.brand-name::after {
    content: "";

    position: absolute;

    bottom: -11px;

    width: 30px;
    height: 1px;

    background: var(--gold);
}

.brand-name::before {
    left: 0;
}

.brand-name::after {
    right: 0;
}

.brand-sub {
    margin-top: 12px;

    color: var(--gold);

    font-size: 0.56rem;

    letter-spacing: 0.38em;
}


/* =========================
   NAVIGATION
========================= */

.main-nav {
    display: flex;

    align-items: center;

    gap: clamp(20px, 2.4vw, 43px);
}

.main-nav a {
    position: relative;

    padding: 31px 0 27px;

    color: rgba(255, 255, 255, 0.78);

    font-size: 0.67rem;

    font-weight: 400;

    text-transform: uppercase;

    transition: color 0.25s ease;
}

.main-nav a::after {
    content: "";

    position: absolute;

    left: 50%;
    bottom: 18px;

    width: 0;
    height: 3px;

    border-radius: 20px;

    background: var(--pink);

    transform: translateX(-50%);

    transition: width 0.3s ease;
}

.main-nav a:hover {
    color: white;
}

.main-nav a:hover::after {
    width: 28px;
}


/* =========================
   HEADER ACTIONS
========================= */

.header-actions {
    display: flex;

    justify-content: flex-end;
    align-items: center;

    gap: 25px;
}

.language-switcher {
    display: flex;

    align-items: center;

    gap: 9px;

    color: rgba(255, 255, 255, 0.35);

    font-size: 0.7rem;
}

.lang-btn {
    border: 0;

    background: transparent;

    color: rgba(255, 255, 255, 0.58);

    font-size: 0.67rem;

    letter-spacing: 0.12em;

    cursor: pointer;

    transition: color 0.25s ease;
}

.lang-btn:hover,
.lang-btn.active {
    color: var(--gold);
}

.header-book {
    min-height: 46px;

    padding: 0 27px;

    font-size: 0.67rem;
}


/* =========================
   MOBILE MENU BUTTON
========================= */

.menu-toggle {
    display: none;

    width: 44px;
    height: 44px;

    border: 1px solid var(--border);

    border-radius: 50%;

    background: transparent;

    cursor: pointer;
}

.menu-toggle span {
    display: block;

    width: 17px;
    height: 1px;

    margin: 5px auto;

    background: var(--cream);
}


/* =========================
   HERO
========================= */

.hero {
    min-height: 780px;

    padding-top: var(--header-height);

    display: grid;

    grid-template-columns: 36% 64%;

    border-bottom: 1px solid var(--border);
}

.hero-copy {
    position: relative;

    z-index: 3;

    min-height: 700px;

    display: flex;

    flex-direction: column;

    justify-content: center;

    align-items: flex-start;

    padding:
        90px
        clamp(35px, 6vw, 105px);
}

.hero-copy::after {
    content: "";

    position: absolute;

    inset: 0;

    z-index: -1;

    background:
        radial-gradient(
            circle at 10% 50%,
            rgba(8, 62, 43, 0.28),
            transparent 45%
        );
}

.hero h1 {
    max-width: 560px;

    font-size: clamp(3.6rem, 5.2vw, 6.2rem);
}

.hero .pink-button {
    margin-top: 35px;

    min-width: 220px;
}

.scroll-label {
    position: absolute;

    left: clamp(35px, 4vw, 70px);
    bottom: 42px;

    padding-left: 22px;

    color: var(--gold);

    font-size: 0.62rem;

    letter-spacing: 0.32em;

    text-transform: uppercase;
}

.scroll-label::before {
    content: "";

    position: absolute;

    left: 0;
    top: -5px;

    width: 1px;
    height: 31px;

    background: var(--gold);
}


/* =========================
   HERO IMAGE
========================= */

.hero-image {
    position: relative;

    min-height: 700px;

    background:
        linear-gradient(
            90deg,
            rgba(1, 11, 8, 0.16),
            transparent 20%
        ),
        linear-gradient(
            180deg,
            transparent 70%,
            rgba(0, 8, 5, 0.3)
        ),
        url("images/hero.jpg");

    background-size: cover;

    background-position: center;

    overflow: hidden;
}

.hero-image::before {
    content: "";

    position: absolute;

    inset: 0;

    background:
        radial-gradient(
            circle at 58% 35%,
            rgba(255, 28, 116, 0.09),
            transparent 25%
        );
}

.hero-side-copy {
    position: absolute;

    top: 16%;
    right: 5%;

    color: var(--gold);

    font-size: 1rem;

    line-height: 2;

    letter-spacing: 0.1em;

    text-transform: uppercase;

    transform: rotate(-5deg);
}

.hero-city {
    position: absolute;

    right: 7%;
    bottom: 8%;

    color: white;

    font-size: 0.67rem;

    letter-spacing: 0.34em;

    text-transform: uppercase;
}

.hero-city::after {
    content: "";

    display: block;

    width: 35px;
    height: 1px;

    margin: 10px 0 0 auto;

    background: var(--gold);
}


/* =========================
   SPLIT SECTIONS
========================= */

.split-section {
    min-height: 520px;

    display: grid;

    grid-template-columns: 42% 58%;

    border-bottom: 1px solid var(--border);
}

.split-copy {
    min-height: 520px;

    padding:
        80px
        clamp(40px, 6vw, 100px);

    display: flex;

    flex-direction: column;

    justify-content: center;

    align-items: flex-start;

    background:
        radial-gradient(
            circle at 0 50%,
            rgba(8, 61, 43, 0.24),
            transparent 45%
        ),
        var(--bg);
}

.split-copy h2 {
    font-size: clamp(3.1rem, 4.6vw, 5.3rem);
}

.split-copy > p:not(.eyebrow) {
    max-width: 470px;

    margin-bottom: 30px;

    font-size: 0.98rem;
}

.split-image {
    min-height: 520px;

    position: relative;

    background-size: cover;

    background-position: center;
}


/* =========================
   ROOMS INTRO
========================= */

.rooms-image {
    background-image:
        linear-gradient(
            90deg,
            rgba(0, 12, 8, 0.22),
            transparent 30%
        ),
        url("images/rooms-hero.jpg");
}

.vertical-message {
    position: absolute;

    top: 50%;
    left: 50%;

    transform: translate(-50%, -50%);

    color: var(--gold);

    font-size: 0.75rem;

    line-height: 2.25;

    letter-spacing: 0.25em;

    text-align: center;

    text-transform: uppercase;
}


/* =========================
   ROOM LIST
========================= */

.room-list {
    padding: 110px max(4%, calc((100vw - var(--content-width)) / 2));

    background:
        radial-gradient(
            circle at 50% 0,
            rgba(8, 54, 38, 0.25),
            transparent 40%
        ),
        var(--bg-deep);

    border-bottom: 1px solid var(--border);
}

.section-heading {
    max-width: 700px;

    margin: 0 auto 60px;

    text-align: center;
}

.section-heading h2 {
    margin-bottom: 22px;

    font-size: clamp(3rem, 5vw, 5rem);
}

.section-heading > p:last-child {
    font-size: 1rem;
}

.room-grid {
    width: min(var(--content-width), 100%);

    margin: auto;

    display: grid;

    grid-template-columns: repeat(4, 1fr);

    gap: 17px;
}

.room-card {
    position: relative;

    min-width: 0;

    background: #06110d;

    border: 1px solid var(--border);

    overflow: hidden;

    transition:
        transform 0.4s ease,
        border-color 0.4s ease,
        box-shadow 0.4s ease;
}

.room-card:hover {
    transform: translateY(-8px);

    border-color: var(--gold);

    box-shadow: 0 25px 50px rgba(0, 0, 0, 0.35);
}

.room-card img {
    width: 100%;
    height: 370px;

    object-fit: cover;

    filter: saturate(0.95);

    transition: transform 0.6s ease;
}

.room-card:hover img {
    transform: scale(1.045);
}

.room-card-copy {
    position: relative;

    padding: 23px 22px 27px;
}

.room-card-copy::before {
    content: "";

    position: absolute;

    top: 0;
    left: 22px;

    width: 35px;
    height: 1px;

    background: var(--pink);
}

.room-card h3 {
    margin-bottom: 4px;

    color: var(--cream);

    font-family: var(--serif);

    font-size: 1.65rem;

    font-weight: 500;
}

.room-card p {
    margin-top: 8px;

    font-size: 0.82rem;

    line-height: 1.5;
}

.room-card p:nth-of-type(1) {
    color: var(--gold);

    font-size: 0.67rem;

    letter-spacing: 0.08em;

    text-transform: uppercase;
}


/* =========================
   FOOD SECTION
========================= */

.food-section {
    grid-template-columns: 64% 36%;
}

.food-image {
    background-image:
        linear-gradient(
            90deg,
            rgba(0, 0, 0, 0.06),
            rgba(0, 13, 9, 0.22)
        ),
        url("images/food-drinks.jpg");

    background-position: center;
}

.food-section .split-copy {
    background:
        radial-gradient(
            circle at 100% 50%,
            rgba(9, 55, 39, 0.3),
            transparent 55%
        ),
        var(--bg);
}


/* =========================
   MENU
========================= */

.menu-section {
    padding: 110px max(5%, calc((100vw - 1300px) / 2));

    background:
        linear-gradient(
            180deg,
            #04120d,
            #020a07
        );

    border-bottom: 1px solid var(--border);
}

.menu-columns {
    width: min(1300px, 100%);

    margin: auto;

    display: grid;

    grid-template-columns: repeat(4, 1fr);

    gap: 22px;
}

.menu-column {
    padding: 30px;

    background:
        linear-gradient(
            145deg,
            rgba(255, 255, 255, 0.025),
            rgba(255, 255, 255, 0.005)
        );

    border-top: 1px solid var(--gold);
    border-bottom: 1px solid var(--border-soft);
}

.menu-column h3 {
    margin-bottom: 25px;

    color: var(--cream);

    font-family: var(--serif);

    font-size: 1.7rem;

    font-weight: 500;
}

.menu-column p {
    display: flex;

    justify-content: space-between;

    align-items: flex-start;

    gap: 15px;

    padding: 12px 0;

    border-bottom: 1px solid rgba(255, 255, 255, 0.06);

    font-size: 0.82rem;
}

.menu-column p:last-child {
    border-bottom: 0;
}

.menu-column strong {
    flex-shrink: 0;

    color: var(--gold);

    font-weight: 400;
}


/* =========================
   EXPERIENCE
========================= */

.experience-section {
    min-height: 610px;

    display: flex;

    align-items: center;
    justify-content: center;

    padding: 100px 5%;

    background:
        linear-gradient(
            rgba(0, 12, 8, 0.55),
            rgba(0, 12, 8, 0.72)
        ),
        url("images/experience.jpg");

    background-size: cover;

    background-position: center;

    border-bottom: 1px solid var(--border);
}

.section-heading.narrow {
    max-width: 750px;

    margin: 0;

    padding: 60px;

    background: rgba(1, 12, 8, 0.65);

    border: 1px solid rgba(230, 189, 119, 0.22);

    backdrop-filter: blur(7px);
}

.section-heading.narrow h2 {
    font-size: clamp(3rem, 5vw, 5.5rem);
}


/* =========================
   ABOUT
========================= */

.about-section {
    min-height: 560px;

    display: flex;

    align-items: center;

    padding: 90px max(7%, calc((100vw - 1300px) / 2));

    background:
        linear-gradient(
            90deg,
            rgba(1, 12, 8, 0.98) 0%,
            rgba(1, 12, 8, 0.82) 45%,
            rgba(1, 12, 8, 0.18) 100%
        ),
        url("images/about.jpg");

    background-size: cover;

    background-position: center;
}

.about-copy {
    max-width: 650px;
}

.about-copy h2 {
    margin-bottom: 30px;

    font-size: clamp(3.1rem, 5vw, 5.4rem);
}

.about-copy > p:last-child {
    max-width: 530px;

    font-size: 1rem;

    line-height: 1.8;
}


/* =========================
   FINAL CTA
========================= */

.cta-section {
    min-height: 420px;

    display: flex;

    align-items: center;
    justify-content: center;

    padding: 80px 5%;

    text-align: center;

    background:
        linear-gradient(
            rgba(0, 18, 12, 0.35),
            rgba(0, 12, 8, 0.48)
        ),
        url("images/cta.jpg");

    background-size: cover;

    background-position: center;

    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
}

.cta-content {
    position: relative;

    z-index: 2;
}

.eyebrow.pink {
    color: var(--pink-light);
}

.cta-content h2 {
    margin-bottom: 35px;

    font-size: clamp(3.2rem, 5vw, 5.4rem);
}

.cta-content .pink-button {
    min-width: 245px;
}


/* =========================
   FOOTER
========================= */

.site-footer {
    width: 100%;

    min-height: 150px;

    padding: 35px max(5%, calc((100vw - var(--content-width)) / 2));

    display: grid;

    grid-template-columns:
        minmax(180px, 1fr)
        auto
        minmax(160px, 0.6fr)
        auto;

    align-items: center;

    gap: 40px;

    background: #010805;
}

.footer-brand .brand-name {
    font-size: 1.55rem;
}

.footer-nav {
    display: flex;

    align-items: center;

    gap: 35px;
}

.footer-nav a {
    color: rgba(255, 255, 255, 0.65);

    font-size: 0.6rem;

    text-transform: uppercase;

    transition: color 0.25s ease;
}

.footer-nav a:hover {
    color: var(--gold);
}

.footer-socials {
    display: flex;

    justify-content: center;

    gap: 18px;
}

.footer-socials a {
    display: flex;

    width: 34px;
    height: 34px;

    align-items: center;
    justify-content: center;

    border: 1px solid rgba(255, 59, 141, 0.55);

    border-radius: 50%;

    color: var(--pink);

    font-size: 0.58rem;

    transition:
        background 0.25s ease,
        color 0.25s ease;
}

.footer-socials a:hover {
    background: var(--pink);

    color: white;
}

.footer-location {
    padding-left: 30px;

    border-left: 1px solid var(--gold);

    color: rgba(255, 255, 255, 0.75);

    font-size: 0.62rem;

    line-height: 1.5;

    letter-spacing: 0.12em;

    text-transform: uppercase;
}


/* =========================
   SUBTLE ANIMATIONS
========================= */

.room-card,
.menu-column,
.section-heading,
.split-copy > * {
    transition:
        opacity 0.6s ease,
        transform 0.6s ease;
}


/* =========================================================
   TABLET
   ========================================================= */

@media (max-width: 1180px) {

    .header-inner {
        grid-template-columns: auto 1fr auto;
    }

    .main-nav {
        gap: 18px;
    }

    .main-nav a {
        font-size: 0.6rem;
    }

    .header-book {
        display: none;
    }

    .hero {
        grid-template-columns: 42% 58%;
    }

    .room-grid {
        grid-template-columns: repeat(2, 1fr);

        max-width: 900px;
    }

    .room-card img {
        height: 430px;
    }

    .menu-columns {
        grid-template-columns: repeat(2, 1fr);

        max-width: 900px;
    }

    .site-footer {
        grid-template-columns: 1fr 1fr;

        row-gap: 40px;
    }

    .footer-nav {
        justify-content: flex-end;
    }

    .footer-socials {
        justify-content: flex-start;
    }

}


/* =========================================================
   MOBILE NAVIGATION
   ========================================================= */

@media (max-width: 850px) {

    :root {
        --header-height: 72px;
    }

    .header-inner {
        width: 90%;

        min-height: 72px;

        display: flex;

        justify-content: space-between;
    }

    .brand-name {
        font-size: 1.45rem;
    }

    .brand-sub {
        font-size: 0.48rem;
    }

    .menu-toggle {
        display: block;

        order: 3;
    }

    .header-actions {
        margin-left: auto;
    }

    .header-actions .header-book {
        display: none;
    }

    .main-nav {
        position: fixed;

        top: 72px;
        left: 0;

        width: 100%;

        max-height: 0;

        padding: 0 7%;

        flex-direction: column;

        align-items: flex-start;

        gap: 0;

        overflow: hidden;

        background: rgba(1, 10, 7, 0.98);

        border-bottom: 1px solid var(--border);

        opacity: 0;

        pointer-events: none;

        transition:
            max-height 0.4s ease,
            opacity 0.3s ease,
            padding 0.4s ease;
    }

    /*
       script-new.js lisää myöhemmin
       .menu-open luokan headeriin.
    */

    .site-header.menu-open .main-nav {
        max-height: 500px;

        padding-top: 20px;
        padding-bottom: 25px;

        opacity: 1;

        pointer-events: auto;
    }

    .main-nav a {
        width: 100%;

        padding: 15px 0;

        font-size: 0.75rem;

        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    }

    .main-nav a::after {
        display: none;
    }


    /* HERO */

    .hero {
        min-height: auto;

        grid-template-columns: 1fr;

        padding-top: 72px;
    }

    .hero-image {
        order: 1;

        min-height: 65vh;

        background-position: 58% center;
    }

    .hero-copy {
        order: 2;

        min-height: auto;

        padding: 65px 7% 90px;
    }

    .hero h1 {
        font-size: clamp(3.5rem, 14vw, 5.6rem);
    }

    .hero .eyebrow {
        margin-bottom: 15px;
    }

    .spaced-copy {
        font-size: 0.62rem;

        letter-spacing: 0.25em;

        line-height: 1.8;
    }

    .scroll-label {
        display: none;
    }

    .hero-side-copy {
        top: 13%;
        right: 7%;

        font-size: 0.8rem;
    }


    /* SPLIT SECTIONS */

    .split-section,
    .food-section {
        grid-template-columns: 1fr;
    }

    .split-copy {
        min-height: auto;

        padding: 70px 7%;
    }

    .split-copy h2 {
        font-size: clamp(3.3rem, 13vw, 5rem);
    }

    .split-image {
        min-height: 480px;
    }

    .rooms-intro .split-copy {
        order: 1;
    }

    .rooms-intro .split-image {
        order: 2;
    }

    .food-section .food-image {
        order: 1;
    }

    .food-section .split-copy {
        order: 2;
    }


    /* ROOMS */

    .room-list {
        padding: 80px 6%;
    }

    .section-heading {
        margin-bottom: 45px;
    }

    .section-heading h2 {
        font-size: clamp(3rem, 12vw, 4.6rem);
    }

    .room-grid {
        grid-template-columns: 1fr 1fr;

        gap: 13px;
    }

    .room-card img {
        height: 330px;
    }


    /* MENU */

    .menu-section {
        padding: 80px 6%;
    }

    .menu-columns {
        grid-template-columns: 1fr 1fr;
    }


    /* EXPERIENCE */

    .experience-section {
        min-height: 550px;

        padding: 60px 6%;
    }

    .section-heading.narrow {
        padding: 45px 30px;
    }


    /* ABOUT */

    .about-section {
        min-height: 620px;

        align-items: flex-end;

        padding: 70px 7%;

        background:
            linear-gradient(
                0deg,
                rgba(1, 12, 8, 0.98) 0%,
                rgba(1, 12, 8, 0.7) 55%,
                rgba(1, 12, 8, 0.15) 100%
            ),
            url("images/about.jpg");

        background-size: cover;

        background-position: center;
    }

    .about-copy h2 {
        font-size: clamp(3.1rem, 12vw, 5rem);
    }


    /* FOOTER */

    .site-footer {
        grid-template-columns: 1fr;

        justify-items: center;

        gap: 30px;

        padding: 50px 7%;

        text-align: center;
    }

    .footer-nav {
        justify-content: center;

        flex-wrap: wrap;

        gap: 15px 25px;
    }

    .footer-socials {
        justify-content: center;
    }

    .footer-location {
        padding: 20px 0 0;

        border-left: 0;

        border-top: 1px solid var(--gold);
    }

}


/* =========================================================
   SMALL MOBILE
   ========================================================= */

@media (max-width: 560px) {

    .language-switcher {
        gap: 6px;
    }

    .lang-btn {
        font-size: 0.62rem;
    }

    .hero-image {
        min-height: 55vh;
    }

    .hero-copy {
        padding-top: 55px;
    }

    .hero h1 {
        font-size: 3.7rem;
    }

    .pink-button,
    .outline-button {
        min-height: 50px;

        padding: 0 27px;

        gap: 22px;
    }

    .split-image {
        min-height: 390px;
    }

    .room-grid {
        grid-template-columns: 1fr;
    }

    .room-card img {
        height: 390px;
    }

    .menu-columns {
        grid-template-columns: 1fr;
    }

    .menu-column {
        padding: 25px 22px;
    }

    .experience-section {
        min-height: 520px;
    }

    .section-heading.narrow {
        padding: 35px 22px;
    }

    .cta-section {
        min-height: 380px;
    }

    .cta-content h2 {
        font-size: 3.5rem;
    }

}


/* =========================================================
   VERY SMALL PHONES
   ========================================================= */

@media (max-width: 390px) {

    .brand-name {
        font-size: 1.25rem;
    }

    .brand-sub {
        letter-spacing: 0.28em;
    }

    .header-actions {
        gap: 10px;
    }

    .hero h1 {
        font-size: 3.2rem;
    }

    .split-copy h2,
    .section-heading h2,
    .about-copy h2 {
        font-size: 3rem;
    }

}


/* =========================================================
   ACCESSIBILITY
   ========================================================= */

@media (prefers-reduced-motion: reduce) {

    html {
        scroll-behavior: auto;
    }

    *,
    *::before,
    *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
    }

}
